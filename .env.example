# 高德开放平台 → 应用管理 → 我的应用 → 添加 Key → Web端(JS API)
VITE_AMAP_KEY=

# Local development only. For a published site use the service proxy below.
VITE_AMAP_SECURITY_JS_CODE=

# Optional HTTPS service proxy following AMap's security configuration guide.
# When set, this takes precedence over the local development security code.
# Example: https://your-domain.example/_AMapService
VITE_AMAP_SERVICE_HOST=
